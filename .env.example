# HIBP — https://haveibeenpwned.com/API/Key — $3.95/mo
HIBP_API_KEY=

# DeHashed — https://dehashed.com — $5.49/mo Pro tier
DEHASHED_USERNAME=
DEHASHED_API_KEY=

# Dark Trace Loom — Python FastAPI OSINT service (maigret 3,125 sites)
# Deploy separately; set endpoint URL and API key here when available
DTL_ENDPOINT=
DTL_API_KEY=

# People Data Labs — paid per-query
PDL_API_KEY=

# GitHub — optional; raises REST API rate limit from 60/hr to 5000/hr
GITHUB_TOKEN=

# WiGLE — https://wigle.net (API name + key, Basic auth)
WIGLE_API_NAME=
WIGLE_API_KEY=

# Resend — https://resend.com (transactional email for org invites)
RESEND_API_KEY=

# Required for customer-portal and invite-member when origin header is missing (e.g. https://app.tjksecurity.com)
APP_ORIGIN=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Enable only after the independently owned backend's Google provider and
# redirect settings have passed an actual sign-in check. No frontend secret.
VITE_GOOGLE_OAUTH_ENABLED=false

# Server-only independent AI configuration. Keep API credentials in the
# destination secret manager, never in VITE_ variables or frontend builds.
AI_CHAT_COMPLETIONS_URL=
AI_API_KEY=
AI_MODEL=
AI_ENABLED=false
AI_ZERO_SPEND_VERIFIED=false
